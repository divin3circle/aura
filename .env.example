# ─────────────────────────────────────────────────────────────
# Aura — environment variables
# Copy this file to `.env` (both Next.js and Prisma read `.env`) and fill in real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database: Neon Postgres (Prisma + @prisma/adapter-neon) ──
# DATABASE_URL  -> pooled connection string (used by the app at runtime)
# DIRECT_URL    -> direct/non-pooled connection (used by Prisma migrate/generate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Auth: Clerk (@clerk/nextjs) ──
# From Clerk dashboard → API Keys. These exact names are read automatically by Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"

# ── Background jobs: Inngest ──
# Used by app/api/inngest to sync Clerk users -> DB and expire coupons.
# Not required for `npx inngest-cli dev` locally, but REQUIRED in production.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Image storage / CDN: ImageKit (configs/imageKit.js) ──
IMAGE_KIT_PUBLIC_KEY="public_xxxxxxxx"
IMAGE_KIT_PRIVATE_KEY="private_xxxxxxxx"
IMAGE_KIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# ── Payments: Paystack (Kenya — cards + M-Pesa) ──
# From Paystack dashboard → Settings → API Keys & Webhooks.
# NOTE: the payment code still calls Stripe; the Paystack swap is not wired up yet.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"

# ── AI: product detail + image generation (DISABLED for now) ──
# Not the current focus — the storefront runs fine without these.
# Only /api/store/ai/* needs them; uncomment and fill in to re-enable AI features.
# configs/openai.js uses an OpenAI-compatible client (details key + base URL + model).
# The image route (app/api/store/ai/images) uses Google Gemini directly.
# PRODUCT_DETAILS_GENERATION_API_KEY=""   # key for the OpenAI-compatible endpoint below
# OPEN_AI_BASE_URL=""                      # e.g. https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini OpenAI-compat) or https://api.openai.com/v1
# OPEN_AI_MODEL=""                         # e.g. gemini-2.5-flash  or  gpt-4o-mini
# GEMINI_API_KEY=""                        # Google AI Studio key (used for gemini-2.5-flash-image)
# BACKUP_GEMINI_API_KEY=""                 # optional fallback Gemini key
# AI_GATEWAY_API_KEY=""                    # only if routing the Vercel AI SDK through Vercel AI Gateway

# ── App config ──
# Comma-separated list of admin emails (admin dashboard + store approval).
ADMIN_EMAIL="you@example.com,sister@example.com"
# Storefront currency symbol shown in the UI (e.g. KES, $, €).
NEXT_PUBLIC_CURRENCY_SYMBOL="KES"
